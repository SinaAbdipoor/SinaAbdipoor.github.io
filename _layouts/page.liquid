---
layout: default
---
{%- comment -%} Overrides al_folio_core page layout: a plain title header. {%- endcomment -%}
<div class="post">
  <header class="post-header banner">
    <div class="banner-inner">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
    </div>
  </header>

  <article>
    {{ content }}
  </article>
</div>
