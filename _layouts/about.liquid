---
layout: default
---
{%- comment -%} Overrides al_folio_core about layout: the home page. The autobiography is in _pages/about.md, and facts come from _data/cv.yaml. {%- endcomment -%}
{% assign h = page.hero %}
{% assign cv = site.data.cv.cv.sections %}
{% assign job = cv['Academic Positions'][0] %}
<section class="hero full-bleed" aria-label="Introduction">
  <div class="hero-inner">
    <div>
      <div class="eyebrow">{{ job.position | split: ', ' | first }} · {{ job.company }}</div>
      <h1>{{ site.first_name }} {{ site.last_name }}<span class="zh">{{ h.chinese_name }}</span></h1>
      <p class="role">{{ h.role }}</p>
      <p class="phd">{{ cv.Education[0].degree }} in {{ cv.Education[0].area }}</p>
      <p class="lede">{{ h.lede }}</p>
      <div class="ctas">
        <a class="btn-x primary" href="{{ '/contact/' | relative_url }}">Get in touch <i class="fa-solid fa-arrow-right"></i></a>
        <a class="btn-x" href="{{ '/resume/' | relative_url }}"><i class="fa-regular fa-file-lines"></i> Resume</a>
      </div>
      {% include social_row.liquid %}
    </div>
    <div class="portrait">
      <img src="{{ '/assets/img/' | append: h.image | relative_url }}" alt="Illustration of {{ site.first_name }} at a blackboard full of optimization notes">
    </div>
    <nav class="paths" aria-labelledby="paths-title">
      <h2 id="paths-title">Where would you like to go?</h2>
      <p class="sub">Pick what fits you best. Everything else is in the menu at the top.</p>
      <div class="path-grid">
        {% for g in page.paths %}
          <div class="path{% if forloop.first %} first{% endif %}">
            <div class="ic"><i class="fa-solid {{ g.icon }}" aria-hidden="true"></i></div>
            <h3>{{ g.title }}</h3>
            <p>{{ g.text }}</p>
            <ul>
              {% for l in g.links %}<li><a href="{{ l.url | relative_url }}">{{ l.name }}</a></li>{% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </nav>
  </div>
</section>

{%- comment -%} Numbers, all from the CV and papers.bib {%- endcomment -%}
{% assign impact = cv['Research Profile'] | where: 'label', 'Impact' | first %}
{% assign citations = impact.details | split: ' citations' | first %}
<div class="stats">
  <div class="stat"><div class="n">{% bibliography_count %}</div><div class="l">Publications</div></div>
  <div class="stat"><div class="n">{{ citations }}</div><div class="l">Citations</div></div>
  <div class="stat"><div class="n">{% include teaching_since.liquid %}</div><div class="l">Teaching since</div></div>
  <div class="stat"><div class="n">{{ cv['Peer Review'].size }}</div><div class="l">Journals reviewed for</div></div>
</div>

<section class="block about-me">
  <div class="head"><h2>About me</h2></div>
  <div class="prose">{{ content }}</div>
</section>

<section class="block" id="bio">
  <div class="head"><h2>Biography</h2></div>
  <div class="bio">
    <img src="{{ '/assets/img/headshot.jpg' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
    <div>
      {%- comment -%} Sina's own wording. Facts that change over time come from cv.yaml. {%- endcomment -%}
      {%- assign role = job.position | split: ', ' -%}
      {%- assign first = role[0] | slice: 0 | downcase -%}
      {%- capture journals -%}
        {%- assign recent = cv['Peer Review'] | reverse | slice: 0, 3 -%}
        {%- for r in recent -%}
          {%- assign name = r.name | markdownify | strip_html | strip | split: ', Elsevier' | first -%}
          {%- if forloop.last and forloop.length > 1 %}and {% endif -%}{{ name }}{%- unless forloop.last -%}{% if forloop.length > 2 %}, {% else %} {% endif %}{%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign society = cv['Professional Memberships'][0].name | split: ' (' | first -%}
      {%- assign phd = cv.Education[0] -%}
      {%- assign msc = cv.Education[1] -%}
      {%- assign bsc = cv.Education[2] -%}
      <p id="bio-text">Dr. Sina Abdipoor is {% if "aeiou" contains first %}an{% else %}a{% endif %} {{ role[0] }} in the {{ role[1] }} at {{ job.company }}. His research in Operations Research focuses on metaheuristics and hybrid algorithms for real-world scheduling and timetabling, with an emphasis on highly generalizable methods. His work has appeared in IEEE Access and Intelligent Systems with Applications and has been presented at international conferences including GECCO and PATAT. A member of the {{ society }}, he reviews for {{ journals }}. Holding a {{ phd.degree }} in {{ phd.area }} from {{ phd.institution }}, an {{ msc.degree }} in {{ msc.area }}, and a {{ bsc.degree }} in {{ bsc.area }}, he has also worked as a software engineer and an independent Operations Research consultant. He applies optimization techniques and AI to practical problems, focusing on saving time and supporting UN SDGs 9, 11, and 12.</p>
      <div class="bio-actions">
        <button type="button" class="btn-x small" data-copy-from="bio-text">Copy bio</button>
        <a class="btn-x small" href="{{ '/assets/img/headshot.jpg' | relative_url }}" download="Sina_Abdipoor.jpg">Download photo</a>
      </div>
    </div>
  </div>
</section>
