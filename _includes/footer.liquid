{%- comment -%} Overrides al_folio_core footer: one simple line, and loads the site script. {%- endcomment -%}
<footer class="sticky-bottom" role="contentinfo">
  <div class="container footer-inner">
    <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
    <span>Sunway University · Selangor, Malaysia</span>
  </div>
</footer>
<script defer src="{{ '/assets/js/site.js' | relative_url | bust_file_cache }}"></script>
