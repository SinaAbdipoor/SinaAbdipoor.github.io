{%- comment -%} Overrides al_folio_core footer: name, profile icons, and the date of the last build. Loads the site script. {%- endcomment -%}
<footer class="sticky-bottom" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-id">
      <b>{{ site.first_name }} {{ site.last_name }}</b>
      <span>Sunway University</span>
    </div>
    {% include social_row.liquid %}
    <div class="footer-meta">
      <span>Last updated {{ site.time | date: '%-d %b %Y' }}</span>
      <span>&copy; {{ site.time | date: '%Y' }}</span>
    </div>
  </div>
</footer>
<script defer src="{{ '/assets/js/site.js' | relative_url | bust_file_cache }}"></script>
