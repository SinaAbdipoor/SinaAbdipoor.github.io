{%- comment -%} Overrides al_folio_core project card. `cover` picks the drawn thumbnail in assets/js/site.js, `label` is the small line above the title. {%- endcomment -%}
<a class="proj" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
  <canvas data-cover="{{ project.cover }}" aria-hidden="true"></canvas>
  <div class="body">
    <span class="lbl">{{ project.label }}</span>
    <h4>{{ project.title }}</h4>
    <p>{{ project.description }}</p>
  </div>
</a>
